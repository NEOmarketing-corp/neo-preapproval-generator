{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neo-preapproval-generator",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/oauth/*",
      "/admin/*"
    ]
  },
  "vars": {
    "CANVA_TEMPLATE_ID": "EAHQyRFm6tM"
  },
  "observability": {
    "enabled": true
  }
}
